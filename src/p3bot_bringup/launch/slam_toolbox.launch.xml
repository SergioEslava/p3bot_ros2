<launch>
  <arg name="use_sim_time" default="false" description="Use simulation clock if true."/>
  <arg
    name="params_file"
    default="$(find-pkg-share p3bot_bringup)/config/slam_toolbox.yaml"
    description="Default parameters for slam_toolbox."
  />

  <node
    pkg="slam_toolbox"
    exec="async_slam_toolbox_node"
    name="slam_toolbox"
    output="screen"
  >
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
